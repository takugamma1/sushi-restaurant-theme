{%- doc -%}
  Cart fulfillment chooser: Доставка (delivery) vs Вземане от място (pickup, −10%).

  - Pickup: applies the PICKUP10 discount code (must exist in Admin → Discounts).
  - Delivery: requires an address entered in the address dialog (street picked from
    OpenStreetMap suggestions or filled from the customer's current location, plus
    number / entrance / floor / apartment); saves address + postcode + coordinates
    as cart attributes (they land on the order) and prefills the checkout address.

  @param {string} section_id - section id used for cart section morphing.
{%- enddoc -%}

{%- liquid
  assign mode = cart.attributes['Получаване'] | default: 'Доставка'
  assign saved_address = cart.attributes['Адрес за доставка']
  assign saved_zip = cart.attributes['Пощенски код']

  # Packaging boxes (product handle "opakovka", 0.50 EUR): one box per 8 loose
  # sushi pieces. Items that come in their own packaging (sets, combos, poke,
  # hot dishes, drinks, sauces, extras) count 0. Per-product override: the
  # product metafield custom.pieces. The drawer JS keeps the box line in the
  # cart equal to the required count.
  assign box_product = all_products['opakovka']
  assign box_capacity = 8
  assign loose_pieces = 0
  assign box_in_cart = 0
  for item in cart.items
    if item.product.handle == 'opakovka'
      assign box_in_cart = item.quantity
      continue
    endif
    assign pieces = 0
    assign handles = item.product.collections | map: 'handle'
    if item.product.metafields.custom.pieces != blank
      assign pieces = item.product.metafields.custom.pieces | plus: 0
    elsif handles contains 'setove' or handles contains 'vecherya-za-dvama' or handles contains 'poke' or handles contains 'topli-predlozheniya' or handles contains 'topli-napitki' or handles contains 'bezalkoholni-napitki' or handles contains 'alkoholni-napitki' or handles contains 'sosove-za-sushi' or handles contains 'dobavki'
      assign pieces = 0
    elsif item.product.title contains 'бр'
      assign pieces = item.product.title | split: 'бр' | first | split: '(' | last | split: ' ' | last | plus: 0
    elsif handles contains 'nigiri'
      assign pieces = 2
    elsif handles contains 'sashimi' or handles contains 'tataki'
      assign pieces = 4
    elsif handles contains 'parzheni-rolki'
      assign pieces = 6
    elsif handles contains 'hosomaki' or handles contains 'mango-menyu' or handles contains 'uramaki' or handles contains 'kaliforniya' or handles contains 'futomaki' or handles contains 'vulkani'
      assign pieces = 8
    endif
    assign line_pieces = pieces | times: item.quantity
    assign loose_pieces = loose_pieces | plus: line_pieces
  endfor
  assign boxes_required = loose_pieces | plus: 7 | divided_by: box_capacity

  # TEMPORARY delivery pause (technical issues): delivery cannot be chosen until
  # this moment — 2026-10-05 20:15 Europe/Sofia, as a Unix timestamp. It lifts
  # itself afterwards. Keep in sync with snippets/cart-summary.liquid; set to 0
  # (in both files) to switch the pause off early.
  assign delivery_paused_until = 0
  assign cf_now = 'now' | date: '%s' | plus: 0
  assign delivery_paused = false
  if cf_now < delivery_paused_until
    assign delivery_paused = true
  endif

  # Pause texts follow the storefront language (bg default, en, ru).
  case request.locale.iso_code
    when 'en'
      assign pause_badge = 'after 8:15 PM'
      assign pause_title = 'Delivery is temporarily unavailable'
      assign pause_text = 'Due to technical issues, we can take delivery orders again after 8:15 PM today. You can still order right now and pick it up from the restaurant, with 10% off.'
      assign pause_cta = 'Order now for pickup (−10%)'
      assign pause_close = 'Close'
      assign pause_inline = 'Delivery is unavailable until 8:15 PM today due to technical issues.'
      assign pause_addr = '1 Doctor Nikolay Kolarov St., Briz, Varna'
    when 'ru'
      assign pause_badge = 'после 20:15'
      assign pause_title = 'Доставка временно недоступна'
      assign pause_text = 'По техническим причинам заказы с доставкой сегодня принимаются после 20:15. Вы можете заказать прямо сейчас и забрать заказ в ресторане со скидкой 10%.'
      assign pause_cta = 'Заказать сейчас и забрать самому (−10%)'
      assign pause_close = 'Закрыть'
      assign pause_inline = 'Доставка недоступна до 20:15 сегодня по техническим причинам.'
      assign pause_addr = 'ул. „Д-р Николай Коларов“ 1, кв. Бриз, Варна'
    else
      assign pause_badge = 'след 20:15'
      assign pause_title = 'Доставката е временно недостъпна'
      assign pause_text = 'Поради технически причини днес приемаме поръчки с доставка след 20:15 ч. Можете да поръчате още сега и да вземете поръчката си от ресторанта с 10% отстъпка.'
      assign pause_cta = 'Поръчай сега и вземи от място (−10%)'
      assign pause_close = 'Затвори'
      assign pause_inline = 'Доставката е недостъпна до 20:15 ч. днес поради технически причини.'
      assign pause_addr = 'ул. „Д-р Николай Коларов“ 1, кв. Бриз, Варна'
  endcase
-%}

<cart-fulfillment
  class="cart-fulfillment"
  data-section-id="{{ section_id }}"
  data-mode="{{ mode | escape }}"
  data-address="{{ saved_address | escape }}"
  data-zip="{{ saved_zip | escape }}"
  data-phone="{{ cart.attributes['Телефон'] | escape }}"
  data-delivery-paused-until="{% if delivery_paused %}{{ delivery_paused_until }}{% else %}0{% endif %}"
  {%- if box_product.available -%}
    data-box-variant="{{ box_product.selected_or_first_available_variant.id }}"
    data-box-required="{{ boxes_required }}"
    data-box-in-cart="{{ box_in_cart }}"
  {%- endif -%}
  data-discount-code="PICKUP10"
  data-storefront-token="{{ settings.cf_storefront_token | default: 'e15f5d390489194a77a140ea964309f2' }}"
>
  <p class="cart-fulfillment__label">НАЧИН НА ПОЛУЧАВАНЕ</p>

  <div class="cart-fulfillment__toggle" role="radiogroup" aria-label="Начин на получаване">
    <button
      type="button"
      class="cart-fulfillment__option{% if mode != 'Вземане от място' %} cart-fulfillment__option--active{% endif %}{% if delivery_paused %} cart-fulfillment__option--paused{% endif %}"
      data-cf-mode="Доставка"
      role="radio"
      aria-checked="{% if mode != 'Вземане от място' %}true{% else %}false{% endif %}"
    >
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="5.5" cy="17.5" r="2.5"/><circle cx="18.5" cy="17.5" r="2.5"/><path d="M8 17.5h7M5.5 17.5 8 9h4l3.5 8.5M12 9V6h3"/></svg>
      <span>Доставка</span>
      {%- if delivery_paused -%}
        <span class="cart-fulfillment__badge cart-fulfillment__badge--paused">{{ pause_badge }}</span>
      {%- endif -%}
    </button>
    <button
      type="button"
      class="cart-fulfillment__option{% if mode == 'Вземане от място' %} cart-fulfillment__option--active{% endif %}"
      data-cf-mode="Вземане от място"
      role="radio"
      aria-checked="{% if mode == 'Вземане от място' %}true{% else %}false{% endif %}"
    >
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/><path d="M9 21v-6h6v6"/></svg>
      <span>Вземане от място</span>
      <span class="cart-fulfillment__badge">−10%</span>
    </button>
  </div>

  <div class="cart-fulfillment__body" data-cf-body>
    {%- if mode == 'Вземане от място' -%}
      <p class="cart-fulfillment__note cart-fulfillment__note--ok">
        ✓ Отстъпка −10% приложена. Ще приготвим поръчката за вземане от ресторанта.
      </p>
      <p class="cart-fulfillment__hint">
        Отстъпката не важи за комбо предложенията „Вечеря за двама“.
      </p>
    {%- elsif delivery_paused -%}
      <p class="cart-fulfillment__note cart-fulfillment__note--paused">⚠ {{ pause_inline }}</p>
      <button type="button" class="cart-fulfillment__pick button" data-cf-pause-pickup>
        {{ pause_cta }}
      </button>
    {%- else -%}
      {%- if saved_address != blank -%}
        <div class="cart-fulfillment__address">
          <span class="cart-fulfillment__address-icon" aria-hidden="true">📍</span>
          <span class="cart-fulfillment__address-text">
            {{ saved_address }}
            {%- if saved_zip != blank %} · п.к. {{ saved_zip }}{% endif -%}
          </span>
          <button type="button" class="cart-fulfillment__change" data-cf-open-map>Промени</button>
        </div>
      {%- else -%}
        <button type="button" class="cart-fulfillment__pick button" data-cf-open-map>
          <span aria-hidden="true">📍</span>
          <span>Въведи адрес за доставка</span>
        </button>
        <p class="cart-fulfillment__hint">
          Въведете улица и номер или използвайте текущото си местоположение.
        </p>
        <p class="cart-fulfillment__hint cart-fulfillment__hint--warn">
          ⚠ Бутонът „Към плащане“ се отключва след като посочите адрес.
        </p>
      {%- endif -%}
    {%- endif -%}
    <p class="cart-fulfillment__error" data-cf-error hidden></p>
  </div>

  {%- if box_product.available and boxes_required > 0 -%}
    <p class="cart-fulfillment__hint cart-fulfillment__boxes">
      📦 Опаковка: {{ boxes_required }} {% if boxes_required == 1 %}кутия{% else %}кутии{% endif %}
      ({{ loose_pieces }} хапки, по {{ box_capacity }} в кутия) × {{ box_product.price | money }} — добавя се автоматично.
    </p>
  {%- endif -%}

  {%- liquid
    # Chopsticks / cutlery count. Saved as cart attribute „Клечки“ (lands on the
    # order). Required before checkout for delivery, optional for pickup.
    assign sticks_value = cart.attributes['Клечки'] | append: ''
    assign sticks_num = sticks_value | plus: 0
    assign sticks_is_custom = false
    if sticks_value != blank and sticks_num > 4
      assign sticks_is_custom = true
    endif
  -%}
  <div class="cart-sticks" data-cf-sticks>
    <p class="cart-fulfillment__label">
      КЛЕЧКИ / ПРИБОРИ (БРОЙ)
      {%- if mode != 'Вземане от място' %} <span class="cart-sticks__required" title="Задължително при доставка">*</span>{% endif -%}
    </p>
    <div class="cart-sticks__row" role="group" aria-label="Брой клечки">
      {%- for n in (1..4) -%}
        {%- assign n_str = n | append: '' -%}
        <button
          type="button"
          class="cart-sticks__option{% if sticks_value == n_str %} cart-sticks__option--active{% endif %}"
          data-sticks-value="{{ n }}"
          aria-pressed="{% if sticks_value == n_str %}true{% else %}false{% endif %}"
        >{{ n }}</button>
      {%- endfor -%}
      <input
        class="cart-sticks__custom{% if sticks_is_custom %} cart-sticks__custom--active{% endif %}"
        type="number"
        min="1"
        max="99"
        step="1"
        inputmode="numeric"
        placeholder="друго"
        value="{% if sticks_is_custom %}{{ sticks_value }}{% endif %}"
        data-sticks-custom
        aria-label="Друг брой клечки"
      >
    </div>
    {%- if mode != 'Вземане от място' and sticks_value == blank -%}
      <p class="cart-fulfillment__hint">Изберете брой — задължително при доставка.</p>
    {%- endif -%}
    <p class="cart-fulfillment__error" data-sticks-error hidden></p>
  </div>

  {%- comment -%}
    Contact phone. Saved as cart attribute „Телефон“ (lands on the order) and
    pushed to checkout prefill. Required before checkout for BOTH delivery and
    pickup — the courier / restaurant must be able to reach the customer.
  {%- endcomment -%}
  {%- assign phone_value = cart.attributes['Телефон'] -%}
  <div class="cart-phone" data-cf-phone-box>
    <label class="cart-fulfillment__label" for="cf-phone">
      ТЕЛЕФОН ЗА ВРЪЗКА <span class="cart-sticks__required" title="Задължително">*</span>
    </label>
    <input
      id="cf-phone"
      class="cart-phone__input{% if phone_value != blank %} cart-phone__input--ok{% endif %}"
      type="tel"
      inputmode="tel"
      autocomplete="tel"
      placeholder="08XX XXX XXX"
      maxlength="20"
      value="{{ phone_value | escape }}"
      data-cf-phone
      aria-required="true"
    >
    {%- if phone_value == blank -%}
      <p class="cart-fulfillment__hint">Задължително — за връзка при доставка или въпроси по поръчката.</p>
    {%- endif -%}
    <p class="cart-fulfillment__error" data-phone-error hidden></p>
  </div>
</cart-fulfillment>

{%- comment -%}
  Address dialog lives at drawer level; created once, reused (the JS moves it
  to <body>). Keeps the historical cf-map ids/classes the JS and tests rely on.
{%- endcomment -%}
<dialog id="cf-map-dialog" class="cf-map" aria-labelledby="cf-map-title">
  <div class="cf-map__inner">
    <div class="cf-map__head">
      <h3 id="cf-map-title" class="cf-map__title">Адрес за доставка</h3>
      <button type="button" class="cf-map__close button-unstyled" data-cf-map-close aria-label="Затвори">✕</button>
    </div>

    <button type="button" class="cf-addr__locate" data-cf-locate>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/><circle cx="12" cy="12" r="8"/></svg>
      <span>Използвай моето местоположение</span>
    </button>

    <p class="cf-addr__or" aria-hidden="true"><span>или въведете адреса</span></p>

    <label class="cf-addr__label" for="cf-map-search">Улица, булевард или квартал <span class="cart-sticks__required">*</span></label>
    <div class="cf-map__search-wrap">
      <input
        id="cf-map-search"
        class="cf-map__search"
        type="text"
        placeholder="напр. бул. Цар Освободител или ж.к. Младост 1"
        maxlength="120"
        autocomplete="off"
        aria-required="true"
      >
      <ul class="cf-map__suggestions" data-cf-suggestions hidden></ul>
    </div>

    <label class="cf-addr__label" for="cf-addr-details">Номер / блок, вход, етаж, апартамент <span class="cart-sticks__required">*</span></label>
    <input
      id="cf-addr-details"
      class="cf-map__search"
      type="text"
      placeholder="напр. 25, вх. Б, ет. 3, ап. 12"
      maxlength="80"
      autocomplete="off"
      data-cf-details
      aria-required="true"
    >

    <p class="cf-addr__status" data-cf-addr-status role="status" aria-live="polite" hidden></p>

    <div class="cf-map__actions">
      <button type="button" class="cf-map__confirm button" data-cf-confirm>
        Потвърди адреса
      </button>
    </div>

    <p class="cf-map__hint">Данни за адресите: © OpenStreetMap</p>
  </div>
</dialog>

{%- if delivery_paused -%}
  {%- comment -%} Shown when delivery is chosen while it is paused (JS moves it to <body>). {%- endcomment -%}
  <dialog id="cf-pause-dialog" class="cf-pause" aria-labelledby="cf-pause-title">
    <div class="cf-pause__inner">
      <div class="cf-pause__icon" aria-hidden="true">🛵</div>
      <h3 id="cf-pause-title" class="cf-pause__title">{{ pause_title }}</h3>
      <p class="cf-pause__text">{{ pause_text }}</p>
      <p class="cf-pause__addr"><span aria-hidden="true">📍</span> {{ pause_addr }}</p>
      <button type="button" class="cf-pause__cta button" data-cf-pause-pickup>{{ pause_cta }}</button>
      <button type="button" class="cf-pause__close button-unstyled" data-cf-pause-close>{{ pause_close }}</button>
    </div>
  </dialog>
{%- endif -%}

{%- comment -%}
  NOTE: no <script> tag here on purpose. This snippet only renders when the cart
  has items, and when it arrives via a section morph (first item added) injected
  <script> tags never execute. The module is loaded unconditionally from
  header-actions.liquid instead.
{%- endcomment -%}

{% stylesheet %}
  /* Wider cart drawer (still a drawer) */
  .cart-drawer__dialog {
    width: min(520px, 100%);
    max-width: min(520px, 100%);
  }

  /* ── Fulfillment block ─────────────────────────────── */
  .cart-fulfillment {
    display: block;
    padding: var(--padding-md) 0 var(--padding-sm);
    border-block-start: 1px solid var(--color-border);
  }

  .cart-fulfillment__label {
    margin: 0 0 var(--margin-xs);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }

  .cart-fulfillment__toggle {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }

  .cart-fulfillment__option {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.3rem 0.45rem;
    min-height: 44px;
    padding: 0.55rem 0.4rem;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: transparent;
    color: var(--color-foreground);
    font-size: 0.78rem;
    font-weight: 500;
    line-height: 1.2;
    text-align: center;
    cursor: pointer;
    transition: border-color 0.25s ease, background 0.25s ease, color 0.25s ease;
  }

  .cart-fulfillment__option svg { flex-shrink: 0; }

  .cart-fulfillment__option--active {
    border-color: #f98760;
    background: rgba(249, 135, 96, 0.1);
    color: #f98760;
    box-shadow: inset 0 0 0 1px #f98760;
  }

  /* While the cart call is in flight: keep the optimistic state visible, block double taps */
  .cart-fulfillment[aria-busy='true'] .cart-fulfillment__toggle,
  .cart-fulfillment[aria-busy='true'] [data-cf-body] {
    opacity: 0.55;
    pointer-events: none;
    transition: opacity 0.15s ease;
  }

  @media screen and (max-width: 420px) {
    /* Narrow drawer: icons steal the room the labels need */
    .cart-fulfillment__option svg { display: none; }
  }

  .cart-fulfillment__badge {
    font-size: 0.66rem;
    font-weight: 700;
    padding: 0.1rem 0.35rem;
    border-radius: 999px;
    background: #f98760;
    color: #1a0e08;
  }

  .cart-fulfillment__body { margin-top: 0.65rem; }

  /* ── Chopsticks / cutlery count ────────────────────── */
  .cart-sticks {
    margin-top: 0.9rem;
    padding-top: 0.8rem;
    border-block-start: 1px dashed var(--color-border);
  }

  .cart-sticks__required { color: #f98760; }

  .cart-sticks__row {
    display: flex;
    align-items: stretch;
    gap: 0.45rem;
  }

  .cart-sticks__option,
  .cart-sticks__custom {
    height: 42px;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: transparent;
    color: var(--color-foreground);
    font-size: 0.9rem;
    font-weight: 500;
    transition: border-color 0.25s ease, background 0.25s ease, color 0.25s ease;
  }

  .cart-sticks__option {
    flex: 1 1 0;
    cursor: pointer;
  }

  .cart-sticks__option:hover { border-color: rgba(249, 135, 96, 0.6); }

  .cart-sticks__option--active,
  .cart-sticks__custom--active {
    border-color: #f98760;
    background: rgba(249, 135, 96, 0.12);
    color: #f98760;
  }

  .cart-sticks__custom {
    flex: 1.4 1 0;
    min-width: 4.2rem;
    padding: 0 0.6rem;
    text-align: center;
    -moz-appearance: textfield;
  }

  .cart-sticks__custom::-webkit-outer-spin-button,
  .cart-sticks__custom::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }

  .cart-sticks__custom::placeholder { color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text)); }

  .cart-fulfillment__note {
    margin: 0;
    font-size: 0.78rem;
    line-height: 1.45;
  }

  .cart-fulfillment__note--ok { color: #7fc98b; }

  .cart-fulfillment__hint {
    margin: 0.45rem 0 0;
    font-size: 0.72rem;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }

  .cart-fulfillment__hint--warn { color: #f0b070; }

  /* Checkout locked until an address is chosen (delivery) */
  .cart__checkout-button--blocked {
    opacity: 0.45;
    filter: grayscale(0.4);
    cursor: not-allowed;
  }

  .cart-fulfillment__pick {
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding-block: 0.8rem;
  }

  .cart-fulfillment__address {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    padding: 0.6rem 0.75rem;
    border: 1px dashed var(--color-border);
    border-radius: 10px;
    font-size: 0.78rem;
    line-height: 1.4;
  }

  .cart-fulfillment__address-text { flex: 1; }

  .cart-fulfillment__change {
    background: none;
    border: none;
    padding: 0;
    color: #f98760;
    font-size: 0.74rem;
    font-weight: 600;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .cart-fulfillment__error {
    margin: 0.5rem 0 0;
    font-size: 0.74rem;
    color: #e66;
  }

  /* ── Contact phone ─────────────────────────────────── */
  .cart-phone { margin-top: 0.9rem; }

  .cart-phone__input {
    width: 100%;
    min-height: 44px;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: transparent;
    color: var(--color-foreground);
    font-size: 0.9rem;
    letter-spacing: 0.03em;
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .cart-phone__input:focus {
    outline: none;
    border-color: #f98760;
    box-shadow: inset 0 0 0 1px #f98760;
  }

  .cart-phone__input--ok { border-color: #7fc98b; }

  .cart-phone__input--error {
    border-color: #e66;
    box-shadow: inset 0 0 0 1px #e66;
  }

  /* ── Temporary delivery pause ──────────────────────── */
  .cart-fulfillment__option--paused {
    opacity: 0.55;
    border-style: dashed;
  }

  .cart-fulfillment__badge--paused {
    background: transparent;
    border: 1px solid #f0b070;
    color: #f0b070;
    font-weight: 600;
    white-space: nowrap;
  }

  .cart-fulfillment__note--paused {
    color: #f0b070;
    margin-bottom: 0.6rem;
  }

  dialog.cf-pause {
    border: 1px solid var(--color-border, #2a2a2a);
    border-radius: 16px;
    padding: 0;
    width: min(440px, calc(100vw - 2rem));
    background: var(--color-background, #141414);
    color: var(--color-foreground, #fff);
  }

  dialog.cf-pause::backdrop { background: rgb(0 0 0 / 0.65); }

  .cf-pause__inner {
    padding: 1.6rem 1.3rem 1.1rem;
    text-align: center;
  }

  .cf-pause__icon { font-size: 2.2rem; line-height: 1; }

  .cf-pause__title {
    margin: 0.7rem 0 0.5rem;
    font-size: 1.1rem;
    letter-spacing: 0.03em;
  }

  .cf-pause__text {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.5;
    color: rgb(var(--color-foreground-rgb, 255 255 255) / 0.85);
  }

  .cf-pause__addr {
    margin: 0.8rem 0 0;
    font-size: 0.8rem;
    color: rgb(var(--color-foreground-rgb, 255 255 255) / 0.7);
  }

  .cf-pause__cta {
    display: block;
    width: 100%;
    margin-top: 1.1rem;
    padding-block: 0.95rem;
    font-size: 0.95rem;
    font-weight: 700;
  }

  .cf-pause__close {
    margin-top: 0.7rem;
    padding: 0.4rem 0.8rem;
    font-size: 0.8rem;
    opacity: 0.7;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .cf-pause__close:hover { opacity: 1; }

  /* ── Address dialog ────────────────────────────────── */
  dialog.cf-map {
    border: 1px solid var(--color-border, #2a2a2a);
    border-radius: 16px;
    padding: 0;
    width: min(560px, calc(100vw - 2rem));
    background: var(--color-background, #141414);
    color: var(--color-foreground, #fff);
  }

  dialog.cf-map::backdrop { background: rgb(0 0 0 / 0.6); }

  .cf-map__inner { padding: 1.1rem 1.1rem 1rem; }

  .cf-map__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .cf-map__title {
    margin: 0;
    font-size: 1rem;
    letter-spacing: 0.04em;
  }

  .cf-map__close {
    font-size: 1rem;
    line-height: 1;
    padding: 0.4rem;
    cursor: pointer;
    opacity: 0.7;
  }
  .cf-map__close:hover { opacity: 1; }

  .cf-map__search-wrap {
    position: relative;
    margin-bottom: 0.65rem;
  }

  .cf-map__search {
    width: 100%;
    padding: 0.65rem 0.8rem;
    border: 1px solid var(--color-border, #2a2a2a);
    border-radius: 10px;
    background: var(--color-input-background, #1a1a1a);
    color: var(--color-input-text, #fff);
    font-size: 0.85rem;
  }

  .cf-map__suggestions {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    right: 0;
    z-index: 5;
    margin: 0;
    padding: 0.25rem;
    list-style: none;
    background: var(--color-background, #141414);
    border: 1px solid var(--color-border, #2a2a2a);
    border-radius: 10px;
    box-shadow: 0 12px 30px rgb(0 0 0 / 0.45);
    max-height: 210px;
    overflow: auto;
  }

  .cf-map__suggestion {
    display: block;
    width: 100%;
    text-align: left;
    background: none;
    border: none;
    border-radius: 7px;
    padding: 0.5rem 0.6rem;
    color: var(--color-foreground, #fff);
    font-size: 0.78rem;
    line-height: 1.35;
    cursor: pointer;
  }

  .cf-map__suggestion:hover {
    background: rgba(249, 135, 96, 0.12);
    color: #f98760;
  }

  .cf-map__hint {
    margin: 0.55rem 0 0;
    font-size: 0.72rem;
    color: rgb(var(--color-foreground-rgb, 255 255 255) / 0.6);
  }

  .cf-map__actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 0.8rem;
  }

  .cf-map__confirm { width: 100%; padding-block: 0.8rem; }

  .cf-map__suggestion--manual {
    border-top: 1px solid var(--color-border, #2a2a2a);
    border-radius: 0 0 7px 7px;
    opacity: 0.8;
    font-style: italic;
  }

  .cf-addr__locate {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    min-height: 44px;
    padding: 0.6rem 0.8rem;
    border: 1px solid #f98760;
    border-radius: 10px;
    background: rgba(249, 135, 96, 0.1);
    color: #f98760;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
  }
  .cf-addr__locate:hover { background: rgba(249, 135, 96, 0.18); }

  .cf-addr__or {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0.85rem 0 0.2rem;
    font-size: 0.7rem;
    color: rgb(var(--color-foreground-rgb, 255 255 255) / 0.55);
  }
  .cf-addr__or::before,
  .cf-addr__or::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--color-border, #2a2a2a);
  }

  .cf-addr__label {
    display: block;
    margin: 0.7rem 0 0.3rem;
    font-size: 0.74rem;
    font-weight: 600;
  }

  .cf-addr__status {
    margin: 0.6rem 0 0;
    font-size: 0.76rem;
    line-height: 1.4;
    color: rgb(var(--color-foreground-rgb, 255 255 255) / 0.75);
  }
  .cf-addr__status--error { color: #e66; }

  @media screen and (max-width: 600px) {
    dialog.cf-map {
      width: calc(100vw - 1rem);
      margin: auto;
    }
  }
{% endstylesheet %}
