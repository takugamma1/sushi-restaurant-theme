{%- doc -%}
  Compact language switcher with flags (BG / EN / RU) linking to the current
  page in each published language. Pure anchors — no JS: Shopify serves each
  locale under its own URL prefix (bg = domain default "/", en = "/en",
  ru = "/ru"). Flags are inline SVG so they render on every OS (emoji flags
  fall back to plain letters on Windows).

  @param {string} [context] - 'drawer' for the mobile drawer variant styling.
{%- enddoc -%}

{%- liquid
  # Strip the current locale prefix from the path so we can rebuild the same
  # page URL under each language's own root.
  assign base_path = request.path
  assign current_root = localization.language.root_url
  if current_root != blank and current_root != '/'
    assign head = base_path | slice: 0, current_root.size
    if head == current_root
      assign base_path = base_path | remove_first: current_root
    endif
  endif
  if base_path == blank
    assign base_path = '/'
  endif
-%}

<nav
  class="lang-switcher{% if context == 'drawer' %} lang-switcher--drawer{% endif %}"
  aria-label="Език / Language"
>
  {%- for language in localization.available_languages -%}
    {%- assign root = language.root_url -%}
    {%- if root == '/' -%}{%- assign root = '' -%}{%- endif -%}
    <a
      href="{{ root }}{{ base_path }}"
      class="lang-switcher__item{% if language.iso_code == localization.language.iso_code %} lang-switcher__item--active{% endif %}"
      lang="{{ language.iso_code }}"
      hreflang="{{ language.iso_code }}"
      {% if language.iso_code == localization.language.iso_code %}aria-current="true"{% endif %}
    >
      <span class="lang-switcher__flag" aria-hidden="true">
        {%- case language.iso_code -%}
          {%- when 'bg' -%}
            <svg viewBox="0 0 18 12" xmlns="http://www.w3.org/2000/svg"><rect width="18" height="4" fill="#fff"/><rect y="4" width="18" height="4" fill="#00966E"/><rect y="8" width="18" height="4" fill="#D62612"/></svg>
          {%- when 'en' -%}
            <svg viewBox="0 0 18 12" xmlns="http://www.w3.org/2000/svg"><rect width="18" height="12" fill="#012169"/><path d="M0 0 18 12M18 0 0 12" stroke="#fff" stroke-width="2.4"/><path d="M0 0 18 12M18 0 0 12" stroke="#C8102E" stroke-width="1.2"/><path d="M9 0V12M0 6H18" stroke="#fff" stroke-width="4"/><path d="M9 0V12M0 6H18" stroke="#C8102E" stroke-width="2.4"/></svg>
          {%- when 'ru' -%}
            <svg viewBox="0 0 18 12" xmlns="http://www.w3.org/2000/svg"><rect width="18" height="4" fill="#fff"/><rect y="4" width="18" height="4" fill="#0039A6"/><rect y="8" width="18" height="4" fill="#D52B1E"/></svg>
          {%- else -%}
            <svg viewBox="0 0 18 12" xmlns="http://www.w3.org/2000/svg"><rect width="18" height="12" fill="#888"/></svg>
        {%- endcase -%}
      </span>
      <span class="lang-switcher__code">{{ language.iso_code | upcase }}</span>
    </a>
  {%- endfor -%}
</nav>

{% stylesheet %}
  .lang-switcher {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .lang-switcher__item {
    display: inline-flex;
    align-items: center;
    gap: 0.32rem;
    color: var(--color-foreground);
    opacity: 0.5;
    text-decoration: none;
    font-family: var(--font-body--family);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    padding: 0.2rem 0.25rem;
    border-radius: 6px;
    transition: opacity 0.25s ease, color 0.25s ease;
  }

  .lang-switcher__item:hover {
    opacity: 1;
  }

  .lang-switcher__item--active {
    opacity: 1;
    color: var(--restaurant-accent, #f98760);
    pointer-events: none;
  }

  .lang-switcher__flag {
    display: inline-flex;
    line-height: 0;
  }

  .lang-switcher__flag svg {
    width: 18px;
    height: 12px;
    border-radius: 2px;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.15);
    display: block;
  }

  .lang-switcher__item--active .lang-switcher__flag svg {
    box-shadow: 0 0 0 1px var(--restaurant-accent, #f98760);
  }

  /* Mobile drawer variant: its own centered row above the CTA */
  .lang-switcher--drawer {
    justify-content: center;
    gap: 1.1rem;
    padding: 1.2rem 0 0.5rem;
    margin-top: 0.8rem;
    border-top: 1px solid rgb(255 255 255 / 0.12);
  }

  .lang-switcher--drawer .lang-switcher__item {
    font-size: 0.95rem;
    gap: 0.45rem;
    padding: 0.45rem 0.55rem;
  }

  .lang-switcher--drawer .lang-switcher__flag svg {
    width: 24px;
    height: 16px;
  }
{% endstylesheet %}
