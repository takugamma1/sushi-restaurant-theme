{%- doc -%}
  Language switcher linking to the current page in each published language.
  Pure anchors — Shopify serves each locale under its own URL prefix
  (bg = domain default "/", en = "/en", ru = "/ru"). Flags are inline SVG so
  they render on every OS (emoji flags fall back to plain letters on Windows).

  @param {string} [context] - 'dropdown' = desktop flag dropdown (next to the
    order button, hidden on mobile); 'drawer' = mobile drawer row.
{%- enddoc -%}

{%- liquid
  # Strip the current locale prefix from the path so we can rebuild the same
  # page URL under each language's own root.
  assign base_path = request.path
  assign current_root = localization.language.root_url
  if current_root != blank and current_root != '/'
    assign head = base_path | slice: 0, current_root.size
    if head == current_root
      assign base_path = base_path | remove_first: current_root
    endif
  endif
  if base_path == blank
    assign base_path = '/'
  endif
-%}

{%- capture flag_bg -%}
  <svg viewBox="0 0 18 12" xmlns="http://www.w3.org/2000/svg"><rect width="18" height="4" fill="#fff"/><rect y="4" width="18" height="4" fill="#00966E"/><rect y="8" width="18" height="4" fill="#D62612"/></svg>
{%- endcapture -%}
{%- capture flag_en -%}
  <svg viewBox="0 0 18 12" xmlns="http://www.w3.org/2000/svg"><rect width="18" height="12" fill="#012169"/><path d="M0 0 18 12M18 0 0 12" stroke="#fff" stroke-width="2.4"/><path d="M0 0 18 12M18 0 0 12" stroke="#C8102E" stroke-width="1.2"/><path d="M9 0V12M0 6H18" stroke="#fff" stroke-width="4"/><path d="M9 0V12M0 6H18" stroke="#C8102E" stroke-width="2.4"/></svg>
{%- endcapture -%}
{%- capture flag_ru -%}
  <svg viewBox="0 0 18 12" xmlns="http://www.w3.org/2000/svg"><rect width="18" height="4" fill="#fff"/><rect y="4" width="18" height="4" fill="#0039A6"/><rect y="8" width="18" height="4" fill="#D52B1E"/></svg>
{%- endcapture -%}

{%- if context == 'dropdown' or context == 'sticky' -%}
  <details class="lang-dd{% if context == 'sticky' %} lang-dd--sticky{% endif %}" data-lang-dd>
    <summary class="lang-dd__current" aria-label="Смяна на езика / Change language">
      <span class="lang-switcher__flag" aria-hidden="true">
        {%- case localization.language.iso_code -%}
          {%- when 'bg' -%}{{ flag_bg }}
          {%- when 'en' -%}{{ flag_en }}
          {%- when 'ru' -%}{{ flag_ru }}
        {%- endcase -%}
      </span>
      <span class="lang-switcher__code">{{ localization.language.iso_code | upcase }}</span>
      <svg class="lang-dd__caret" width="9" height="6" viewBox="0 0 9 6" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M1 1.5 4.5 5 8 1.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </summary>
    <div class="lang-dd__menu">
      {%- for language in localization.available_languages -%}
        {%- unless language.iso_code == localization.language.iso_code -%}
          {%- assign root = language.root_url -%}
          {%- if root == '/' -%}{%- assign root = '' -%}{%- endif -%}
          <a
            href="{{ root }}{{ base_path }}"
            class="lang-dd__option"
            lang="{{ language.iso_code }}"
            hreflang="{{ language.iso_code }}"
          >
            <span class="lang-switcher__flag" aria-hidden="true">
              {%- case language.iso_code -%}
                {%- when 'bg' -%}{{ flag_bg }}
                {%- when 'en' -%}{{ flag_en }}
                {%- when 'ru' -%}{{ flag_ru }}
              {%- endcase -%}
            </span>
            <span class="lang-switcher__code">{{ language.iso_code | upcase }}</span>
          </a>
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </details>
  <script>
    if (!window.__langDdWired) {
      window.__langDdWired = true;
      document.addEventListener('click', function (event) {
        document.querySelectorAll('[data-lang-dd][open]').forEach(function (dd) {
          if (!dd.contains(event.target)) dd.removeAttribute('open');
        });
      });
    }
  </script>
{%- else -%}
  <nav
    class="lang-switcher{% if context == 'drawer' %} lang-switcher--drawer{% endif %}"
    aria-label="Език / Language"
  >
    {%- for language in localization.available_languages -%}
      {%- assign root = language.root_url -%}
      {%- if root == '/' -%}{%- assign root = '' -%}{%- endif -%}
      <a
        href="{{ root }}{{ base_path }}"
        class="lang-switcher__item{% if language.iso_code == localization.language.iso_code %} lang-switcher__item--active{% endif %}"
        lang="{{ language.iso_code }}"
        hreflang="{{ language.iso_code }}"
        {% if language.iso_code == localization.language.iso_code %}aria-current="true"{% endif %}
      >
        <span class="lang-switcher__flag" aria-hidden="true">
          {%- case language.iso_code -%}
            {%- when 'bg' -%}{{ flag_bg }}
            {%- when 'en' -%}{{ flag_en }}
            {%- when 'ru' -%}{{ flag_ru }}
          {%- endcase -%}
        </span>
        <span class="lang-switcher__code">{{ language.iso_code | upcase }}</span>
      </a>
    {%- endfor -%}
  </nav>
{%- endif -%}

{% stylesheet %}
  .lang-switcher__flag {
    display: inline-flex;
    line-height: 0;
  }

  .lang-switcher__flag svg {
    width: 18px;
    height: 12px;
    border-radius: 2px;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.15);
    display: block;
  }

  .lang-switcher__code {
    font-family: var(--font-body--family);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  /* ── Desktop dropdown (next to the order button) ── */
  .lang-dd {
    position: relative;
    margin-inline-end: 0.9rem;
  }

  .lang-dd__current {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    cursor: pointer;
    list-style: none;
    color: var(--color-foreground);
    opacity: 0.85;
    padding: 0.35rem 0.4rem;
    border-radius: 8px;
    transition: opacity 0.25s ease;
  }

  .lang-dd__current::-webkit-details-marker {
    display: none;
  }

  .lang-dd__current:hover {
    opacity: 1;
  }

  .lang-dd__caret {
    opacity: 0.7;
    transition: transform 0.25s ease;
  }

  .lang-dd[open] .lang-dd__caret {
    transform: rotate(180deg);
  }

  .lang-dd__menu {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    z-index: 60;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 5.2rem;
    padding: 0.3rem;
    background: rgb(20 18 16 / 0.97);
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 10px;
    box-shadow: 0 12px 30px rgb(0 0 0 / 0.45);
  }

  .lang-dd__option {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.55rem;
    border-radius: 7px;
    color: #fff;
    text-decoration: none;
    opacity: 0.85;
  }

  .lang-dd__option:hover {
    opacity: 1;
    background: rgb(255 255 255 / 0.08);
    color: var(--restaurant-accent, #f98760);
  }

  /* Header dropdown is desktop-only; mobile gets the sticky button + drawer row */
  @media screen and (max-width: 749px) {
    .lang-dd:not(.lang-dd--sticky) {
      display: none !important;
    }
  }

  /* ── Mobile floating sticky button ── */
  .lang-dd--sticky {
    display: none;
    position: fixed;
    right: 0.9rem;
    bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
    z-index: 40;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .lang-dd--sticky {
      display: block;
    }
  }

  .lang-dd--sticky .lang-dd__current {
    gap: 0.45rem;
    padding: 0.55rem 0.85rem;
    border-radius: 999px;
    background: rgb(20 18 16 / 0.92);
    border: 1px solid rgb(255 255 255 / 0.16);
    color: #fff;
    opacity: 1;
    box-shadow: 0 6px 18px rgb(0 0 0 / 0.35);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .lang-dd--sticky .lang-switcher__flag svg {
    width: 20px;
    height: 13px;
  }

  /* Opens upward from the floating button */
  .lang-dd--sticky .lang-dd__menu {
    top: auto;
    bottom: calc(100% + 8px);
  }

  /* ── Inline row (mobile drawer) ── */
  .lang-switcher {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .lang-switcher__item {
    display: inline-flex;
    align-items: center;
    gap: 0.32rem;
    color: var(--color-foreground);
    opacity: 0.5;
    text-decoration: none;
    padding: 0.2rem 0.25rem;
    border-radius: 6px;
    transition: opacity 0.25s ease, color 0.25s ease;
  }

  .lang-switcher__item:hover {
    opacity: 1;
  }

  .lang-switcher__item--active {
    opacity: 1;
    color: var(--restaurant-accent, #f98760);
    pointer-events: none;
  }

  .lang-switcher__item--active .lang-switcher__flag svg {
    box-shadow: 0 0 0 1px var(--restaurant-accent, #f98760);
  }

  .lang-switcher--drawer {
    justify-content: center;
    gap: 1.1rem;
    padding: 1.2rem 0 0.5rem;
    margin-top: 0.8rem;
    border-top: 1px solid rgb(255 255 255 / 0.12);
  }

  .lang-switcher--drawer .lang-switcher__item {
    font-size: 0.95rem;
    gap: 0.45rem;
    padding: 0.45rem 0.55rem;
  }

  .lang-switcher--drawer .lang-switcher__flag svg {
    width: 24px;
    height: 16px;
  }
{% endstylesheet %}
